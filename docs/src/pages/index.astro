---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);

const proofPoints = [
  {
    title: "Zero config",
    body: "Install it and run locguard. A config file exists only when a repository actually needs custom policy."
  },
  {
    title: "Changed-file fast path",
    body: "Bare checks ask Git for current changes so large repositories do not repeatedly rescan unchanged source files."
  },
  {
    title: "Stops at the threshold",
    body: "Once a file is proven to exceed its limit, locguard stops reading it unless exact counts were requested."
  },
  {
    title: "Agent-friendly policy",
    body: "Generated/vendor code is quiet by default and exact legacy exemptions can stay invisible to everyday agents."
  }
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="hero shell">
    <div class="hero__copy">
      <p class="section-label">Source file size guard</p>
      <h1>Keep every source file small enough to understand, edit, and merge safely.</h1>
      <p class="hero__lede">
        locguard is a fast physical-line limit for codebases. It works without setup, respects
        Git and generated-code conventions, and gives coding agents the same simple invariant
        in every repository.
      </p>
      <div class="hero__actions">
        <a class="button button--solid" href="/docs/quickstart">Quickstart</a>
        <a class="button button--ghost" href="/docs/command-reference">Command reference</a>
      </div>
    </div>
    <aside class="hero__panel">
      <p class="hero__panel-label">Everyday loop</p>
      <div class="hero__terminal">
        <span>$ locguard</span>
        <span>✓ 7 files checked</span>
        <span>$ locguard scan</span>
        <span>✓ 1,443 files checked</span>
      </div>
    </aside>
  </section>

  <section class="shell section-grid">
    <div class="section-heading">
      <p class="section-label">Simple invariant</p>
      <h2>Physical file length, deliberately.</h2>
      <p>
        Comments and blank lines count because locguard is not measuring semantic complexity.
        It is keeping source files modular, reducing shared edit hotspots, and limiting the
        amount of context a human or coding agent must load to work safely.
      </p>
    </div>
    <div class="proof-grid">
      {proofPoints.map((item) => (
        <article class="proof-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell docs-teaser">
    <div class="section-heading">
      <p class="section-label">Documentation</p>
      <h2>Start with no config. Customize only where your repository needs it.</h2>
    </div>
    <div class="docs-teaser__grid">
      {docs.map((entry) => (
        <a class="docs-teaser__card" href={`/docs/${entry.id}`}>
          <span>{entry.data.category}</span>
          <h3>{entry.data.title}</h3>
          <p>{entry.data.summary ?? entry.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
